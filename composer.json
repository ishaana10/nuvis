{
    "name": "nubuilder/nuvis",
    "description": "Nuvis - Low-Code Enterprise Application Platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Nuvis\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nuvis\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
